# ============================================================
# LUXEL-G — Variables d'environnement (copier vers .env)
# NE JAMAIS COMMITER LE FICHIER .env SUR GIT
# ============================================================

# --- Environnement ---
DEBUG=True
SECRET_KEY=changez-moi-en-production-avec-une-cle-longue-aleatoire

# --- Hôtes & CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1
# En production (PythonAnywhere) :
# ALLOWED_HOSTS=votre-compte.pythonanywhere.com
CORS_ALLOW_ALL_ORIGINS=True
# Ou bien, en production (restreindre) :
# CORS_ALLOWED_ORIGINS=https://votre-app.netlify.app

# --- Base de données (laisser vide pour SQLite) ---
# En production, ajouter une variable DATABASE_URL ou configurer PostgreSQL :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=luxelg
# DB_USER=luxelg_user
# DB_PASSWORD=motdepasse
# DB_HOST=localhost
# DB_PORT=5432

# --- Configuration Email & SMS (Brevo / Sendinblue) ---
BREVO_API_KEY=votre_cle_api_brevo_v3
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_email_compte_brevo
EMAIL_HOST_PASSWORD=votre_cle_smtp_brevo
DEFAULT_FROM_EMAIL=Luxury Elegance Garage <votre_email_verifie@domaine.com>

# --- OTP (dev uniquement) ---
DEV_EXPOSE_OTP=False

# --- Intelligence Artificielle (Google Gemini) ---
GEMINI_API_KEY=votre_cle_api_gemini_ici

# --- Paiement Kkiapay ---
KKIAPAY_PUBLIC_KEY=votre_cle_publique_kkiapay
KKIAPAY_PRIVATE_KEY=votre_cle_privee_kkiapay
KKIAPAY_SECRET=votre_secret_kkiapay
KKIAPAY_SANDBOX=True

# --- e-MECeF DGI Bénin (Facturation normalisée) ---
EMECEF_API_TOKEN=votre_token_api_emecef
EMECEF_API_URL=https://test-api.impots.bj/sygmef-emcf
